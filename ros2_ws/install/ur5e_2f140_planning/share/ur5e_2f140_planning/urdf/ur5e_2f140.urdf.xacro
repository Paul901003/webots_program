<?xml version="1.0"?>
<robot xmlns:xacro="http://wiki.ros.org/xacro" name="ur5e_2f140">

  <!-- UR5e arm -->
  <xacro:include filename="$(find ur_description)/urdf/ur_macro.xacro"/>

  <!-- Robotiq 2F-140 gripper -->
  <xacro:include filename="$(find robotiq_description)/urdf/robotiq_2f_140_macro.urdf.xacro"/>

  <!-- World link -->
  <link name="world"/>
  <joint name="world_joint" type="fixed">
    <parent link="world"/>
    <child link="base_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- UR5e arm: base_link → tool0 -->
  <xacro:ur_robot
    name="ur5e"
    tf_prefix=""
    parent="world"
    joint_limits_parameters_file="$(find ur_description)/config/ur5e/joint_limits.yaml"
    kinematics_parameters_file="$(find ur_description)/config/ur5e/default_kinematics.yaml"
    physical_parameters_file="$(find ur_description)/config/ur5e/physical_parameters.yaml"
    visual_parameters_file="$(find ur_description)/config/ur5e/visual_parameters.yaml">
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </xacro:ur_robot>

  <!-- Robotiq 2F-140: 接在 tool0，use_fake_hardware=true 用於規劃 -->
  <xacro:robotiq_gripper
    name="gripper"
    prefix=""
    parent="tool0"
    use_fake_hardware="true">
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </xacro:robotiq_gripper>

  <!-- IntelRealsense D455 相機:與 Webots toolSlot 同一掛載(已驗證 tool0→D455 body)。
       collision 用簡化 mesh(凸包精簡,公尺單位),讓 MoveIt 規劃含相機、最貼近真實。 -->
  <link name="camera_link">
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://ur5e_2f140_planning/meshes/IntelRealsenseD455_collision.stl"/>
      </geometry>
    </collision>
  </link>
  <joint name="camera_mount" type="fixed">
    <parent link="tool0"/>
    <child link="camera_link"/>
    <origin xyz="0 -0.10 -0.03" rpy="1.570796 -1.570796 0"/>
  </joint>

  <!-- 桌面/地面:平面用 box(頂面 world z=0)。base 坐桌上 → SRDF 設 base↔table 免碰撞。 -->
  <link name="table_link">
    <collision>
      <origin xyz="0 0 -0.05" rpy="0 0 0"/>
      <geometry>
        <box size="3.0 3.0 0.1"/>
      </geometry>
    </collision>
  </link>
  <joint name="table_mount" type="fixed">
    <parent link="world"/>
    <child link="table_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

</robot>
