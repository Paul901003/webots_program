DEF UR5E UR5e {
  translation -0.4 0 0
  controller "ur5e_test_controller"
  toolSlot [
    Receiver {
      name "arm_command_receiver"
      channel 11
    }
    Emitter {
      name "arm_status_emitter"
      channel 12
    }
    DEF UR5E_CAMERA IntelRealsenseD455 {
      translation 0 -0.03 0.05
      rotation 0 0 1 1.5708
      controller "realsense_auto_capture_controller"
      resolution "HD"
      minRange 0.3
      maxRange 3.0
      fps 30
    }
    Pose {
      rotation 0 1 0 1.5707996938995747
      children [
        Robotiq2f140Gripper {
          rotation 1 0 0 -1.5707996938995747
        }
      ]
    }
  ]
}

Robot {
  supervisor TRUE
  controller "ycb_viewpoint_validator"
  controllerArgs "--multi"
  children [
    Emitter {
      name "arm_command_emitter"
      channel 11
    }
    Receiver {
      name "arm_status_receiver"
      channel 12
    }
  ]
}
